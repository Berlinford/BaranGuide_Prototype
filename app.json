{
  "expo": {
    "name": "BaranGuide_Testv1",
    "web": {
      "output": "static",
      "favicon": "./assets/BaranGuideIcon.png"
    },
    "slug": "BaranGuide_Testv1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/BaranGuideIcon.png",
    "scheme": "baranguidetestv1",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.lafirma.baranguide",
      "icon": "./assets/BaranGuideIcon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lafirma.baranguide",
      "googleServicesFile": "./google-services.json",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "CAMERA"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/BaranGuideIcon.png",
        "backgroundImage": "./assets/BaranGuideIcon.png",
        "monochromeImage": "./assets/BaranGuideIcon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/BaranGuideIcon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-secure-store",
      ["expo-location", { "locationAlwaysAndWhenInUsePermission": "BaranGuide uses your location to send SOS alerts." }],
      ["expo-image-picker", { "photosPermission": "Allow BaranGuide to access your photos.", "cameraPermission": "Allow BaranGuide to use your camera." }],
      ["expo-notifications", { "color": "#D92D20" }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bd3af25e-3468-481c-a036-59a23a16abe6"
      }
    }
  }
}